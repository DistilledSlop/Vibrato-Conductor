{
  "fleet_id": "local",
  "backend": "docker",
  "state_dir": ".state/fleet",
  "artifacts_dir": ".state/artifacts",
  "workspace_dir": ".state/workspaces",
  "image": "vibrato-worker:dev",
  "desired": 0,
  "max_workers": 1,
  "cpus": 8,
  "memory_mb": 6144,
  "storage_mb": 8192,
  "cpu_budget": 8,
  "memory_budget_mb": 6144,
  "storage_budget_mb": 8192,
  "stagger_seconds": 15,
  "startup_timeout": 360,
  "health_timeout": 45,
  "seconds": 300,
  "mode": "diagnostic",
  "accept_eula": false,
  "accept_offline": false,
  "central_dir": ".state/dataset",
  "max_buffer_bytes": 2147483648,
  "enabled_tasks": [
    "director",
    "get-dirt"
  ],
  "delivery_retry_seconds": 15,
  "spool_success_days": 3,
  "spool_failure_days": 14,
  "central_diagnostic_days": 30,
  "central_failure_days": 90,
  "worker_env": {
    "LP_NUM_THREADS": "2"
  }
}
